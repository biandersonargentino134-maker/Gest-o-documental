// Codigo para o rules do banco de dados do firebase

 rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // O requisitante é administrador? (olha o perfil dele na coleção "usuarios")
    function isAdmin() {
      return exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.isAdmin == true;
    }
    // Lista de empresas liberadas pro requisitante
    function minhasEmpresas() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.empresas;
    }

    // Perfil de cada usuário. Cada um só cria o PRÓPRIO perfil, e sempre
    // bloqueado (sem admin e sem empresas). Só admin altera permissões.
    match /usuarios/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create: if request.auth != null && request.auth.uid == uid
                     && request.resource.data.isAdmin == false
                     && request.resource.data.empresas.size() == 0;
      allow update, delete: if request.auth != null && isAdmin();
    }

    // Cadastro de empresas: todo mundo logado lê, só admin cadastra.
    match /empresas/{id} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null && isAdmin();
    }

    // Log de atividade: qualquer usuário logado grava a própria ação,
    // mas só o admin lê o histórico. Ninguém edita um registro já gravado.
    match /logs/{id} {
      allow create: if request.auth != null;
      allow read, delete: if request.auth != null && isAdmin();
      allow update: if false;
    }

    // Documentos: só admin ou quem tem a empresa do documento liberada.
    match /documentos/{id} {
      allow read: if request.auth != null && (isAdmin() || resource.data.empresa in minhasEmpresas());
      allow create: if request.auth != null && (isAdmin() || request.resource.data.empresa in minhasEmpresas());
      allow update, delete: if request.auth != null && (isAdmin() || resource.data.empresa in minhasEmpresas());
    }
  }
}
